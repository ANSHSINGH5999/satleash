# Lifeboat configuration. Every value below is a placeholder: there are no real hosts, keys or credentials in this file.
#
# Lifeboat does NOT read a .env file by itself. Either export the variables in your shell
#   (set -a; source .env; set +a) or pass them inline. Keep your real .env out of git: it is in .gitignore.
# The regtest tools (npm run demo, web, playground, e2e) need none of these variables.

# --- lnd (backup daemon, console monitor, verify, restore) ---
# LND_CERT: your node's TLS certificate. lnd creates it itself, by default at ~/.lnd/tls.cert.
LND_CERT=/path/to/lnd/tls.cert
# LND_MACAROON: a macaroon file. Do not use admin.macaroon for the daemon: bake a least-privilege one with
#   LND_MACAROON=<path to admin.macaroon, used once> npm run cli -- bake --out monitor.macaroon
# then chmod 600 it. `bake --restore --out restore.macaroon` makes the one `restore` needs.
LND_MACAROON=/path/to/monitor.macaroon
# LND_HOST / LND_PORT: where lnd's REST API listens (the `restlisten` setting in lnd.conf; the default port is 8080).
LND_HOST=127.0.0.1
LND_PORT=8080

# --- Nostr relays ---
# RELAYS: comma-separated ws:// or wss:// URLs. YOU choose them (at least two independent ones, wss:// preferred).
# Lifeboat has no default relay. Only encrypted backups are published to them.
RELAYS=wss://relay-one.example,wss://relay-two.example

# --- safety (optional) ---
# LIFEBOAT_NETWORK: the network you mean to use (mainnet, testnet, testnet4, signet, regtest). A node on any other network is refused.
# LIFEBOAT_NETWORK=testnet
# LIFEBOAT_ALLOW_MAINNET: mainnet is refused unless this is 1. Lifeboat is only verified on regtest: do not set it with funds you cannot lose.
# LIFEBOAT_ALLOW_MAINNET=1

# --- console (npm run web) ---
# PORT: console and landing port, always bound to 127.0.0.1 only.
PORT=8080
# STALE_AFTER_SEC: warn when the last publish is older than this (default 28800 = 8 hours).
STALE_AFTER_SEC=28800
# LIFEBOAT_DRILL: 1 keeps the regtest drill button on while a node is attached (the drill wipes the regtest network).
LIFEBOAT_DRILL=0

# --- logging ---
# LOG_LEVEL: debug | info | warn | error        LOG_FORMAT: text | json
LOG_LEVEL=info
LOG_FORMAT=text
